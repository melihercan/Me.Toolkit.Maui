<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="DemoApp.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:buttons="clr-namespace:Syncfusion.Maui.Toolkit.Buttons;assembly=Syncfusion.Maui.Toolkit"
    xmlns:chips="clr-namespace:Syncfusion.Maui.Toolkit.Chips;assembly=Syncfusion.Maui.Toolkit"
    xmlns:tabView="clr-namespace:Syncfusion.Maui.Toolkit.TabView;assembly=Syncfusion.Maui.Toolkit"
    xmlns:me="https://github.com/melihercan/Me.Toolkit.Maui"
    xmlns:vm="clr-namespace:DemoApp.ViewModels"
    x:DataType="vm:MainViewModel"
    Shell.NavBarIsVisible="False">

    <ContentPage.Resources>
        <ResourceDictionary>

            <!--
                Cards are Border, not Syncfusion's SfCardView. SfCardView takes the WinUI head down
                at startup with "COMException: No installed components were detected" — established
                by swapping it out and watching the app start. Border renders the same card and
                works everywhere. SfTabView, SfButton and SfChip are all fine.
            -->
            <Style x:Key="Card" TargetType="Border">
                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#FFFFFF, Dark=#1E1E26}" />
                <Setter Property="Stroke" Value="{AppThemeBinding Light=#E4E4EC, Dark=#34343F}" />
                <Setter Property="StrokeThickness" Value="1" />
                <Setter Property="Padding" Value="14,12" />
                <Setter Property="StrokeShape">
                    <Setter.Value>
                        <RoundRectangle CornerRadius="10" />
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="Caption" TargetType="Label">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="CharacterSpacing" Value="0.8" />
                <Setter Property="TextColor" Value="{AppThemeBinding Light=#6C6C7A, Dark=#9C9CAC}" />
            </Style>

            <Style x:Key="Value" TargetType="Label">
                <Setter Property="FontSize" Value="15" />
                <Setter Property="LineBreakMode" Value="WordWrap" />
            </Style>

            <!-- Me.Toolkit.Maui.Sizing from a style: an attached property, since {me:Relative}
                 cannot go in a Setter. -->
            <Style x:Key="RelativeHeadline" TargetType="Label">
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="me:RelativeSizing.FontSize" Value="4, To=Window, Min=14, Max=48" />
            </Style>

            <Style x:Key="Blurb" TargetType="Label">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="LineBreakMode" Value="WordWrap" />
                <Setter Property="TextColor" Value="{AppThemeBinding Light=#6C6C7A, Dark=#9C9CAC}" />
            </Style>

            <Style TargetType="buttons:SfButton">
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="HeightRequest" Value="44" />
                <Setter Property="Padding" Value="18,0" />
            </Style>

        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*">

        <!-- A header, because the Xamarin demo had one and it made the app feel like something. -->
        <Border
            Padding="16,14"
            BackgroundColor="{AppThemeBinding Light=#512BD4, Dark=#2B1B60}"
            StrokeThickness="0">
            <HorizontalStackLayout Spacing="12" VerticalOptions="Center">
                <Border
                    HeightRequest="42"
                    StrokeThickness="0"
                    WidthRequest="42">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="21" />
                    </Border.StrokeShape>
                    <Image
                        Aspect="AspectFill"
                        HeightRequest="42"
                        Source="me.png"
                        WidthRequest="42" />
                </Border>
                <VerticalStackLayout VerticalOptions="Center">
                    <Label
                        FontAttributes="Bold"
                        FontSize="20"
                        Text="Me.Toolkit.Maui Demo"
                        TextColor="White" />
                    <Label
                        FontSize="12"
                        Text="Five libraries for .NET MAUI"
                        TextColor="#D6CCFF" />
                </VerticalStackLayout>
            </HorizontalStackLayout>
        </Border>

        <tabView:SfTabView Grid.Row="1" TabWidthMode="Default">
            <tabView:SfTabView.Items>

                <!-- Me.Toolkit.Maui.Configuration -->
                <tabView:SfTabItem Header="Config">
                    <tabView:SfTabItem.Content>
                        <Grid BindingContext="{Binding Configuration}" RowDefinitions="Auto,*">
                            <Label
                                Margin="16,14,16,10"
                                Style="{StaticResource Blurb}"
                                Text="Every key the configuration ended up with. Demo:Source shows the environment overlay applied over the base file." />

                            <CollectionView Grid.Row="1" ItemsSource="{Binding Settings}">
                                <CollectionView.ItemTemplate>
                                    <DataTemplate x:DataType="vm:SettingRow">
                                        <Border Margin="16,0,16,10" Style="{StaticResource Card}">
                                            <VerticalStackLayout Spacing="3">
                                                <Label Style="{StaticResource Caption}" Text="{Binding Key}" />
                                                <Label Style="{StaticResource Value}" Text="{Binding Value}" />
                                            </VerticalStackLayout>
                                        </Border>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </Grid>
                    </tabView:SfTabItem.Content>
                </tabView:SfTabItem>

                <!-- Me.Toolkit.Maui.Hosting -->
                <tabView:SfTabItem Header="Hosting">
                    <tabView:SfTabItem.Content>
                        <ScrollView BindingContext="{Binding Hosting}">
                            <VerticalStackLayout Padding="16,14" Spacing="10">

                                <Label
                                    Style="{StaticResource Blurb}"
                                    Text="Without Me.Toolkit.Maui.Hosting this reports Production on every platform, always." />

                                <Border Style="{StaticResource Card}">
                                    <VerticalStackLayout Spacing="8">
                                        <Label Style="{StaticResource Caption}" Text="ENVIRONMENT" />
                                        <!-- Wrapped, because SfChip stretches to fill a
                                             VerticalStackLayout even with HorizontalOptions=Start. -->
                                        <HorizontalStackLayout>
                                            <chips:SfChip Text="{Binding EnvironmentName}" />
                                        </HorizontalStackLayout>
                                        <Label
                                            Style="{StaticResource Value}"
                                            Text="{Binding IsDevelopment, StringFormat='IsDevelopment() → {0}'}" />
                                    </VerticalStackLayout>
                                </Border>

                                <Border Style="{StaticResource Card}">
                                    <VerticalStackLayout Spacing="6">
                                        <Label Style="{StaticResource Caption}" Text="FROM CONFIGURATION" />
                                        <Label Style="{StaticResource Value}" Text="{Binding Greeting}" />
                                        <Label Style="{StaticResource Value}" Text="{Binding Source}" />
                                    </VerticalStackLayout>
                                </Border>

                                <Border Style="{StaticResource Card}">
                                    <VerticalStackLayout Spacing="6">
                                        <Label Style="{StaticResource Caption}" Text="STILL FROM THE PLATFORM" />
                                        <Label
                                            Style="{StaticResource Blurb}"
                                            Text="ContentRootPath is not implemented on Android — the wrapper passes the platform's failure through rather than inventing a value." />
                                        <Label Style="{StaticResource Value}" Text="{Binding ApplicationName}" />
                                        <Label Style="{StaticResource Value}" Text="{Binding ContentRootPath}" />
                                    </VerticalStackLayout>
                                </Border>

                            </VerticalStackLayout>
                        </ScrollView>
                    </tabView:SfTabItem.Content>
                </tabView:SfTabItem>

                <!-- Me.Toolkit.Maui.Nfc -->
                <tabView:SfTabItem Header="NFC">
                    <tabView:SfTabItem.Content>
                        <Grid BindingContext="{Binding Nfc}" RowDefinitions="Auto,*">
                            <VerticalStackLayout Padding="16,14" Spacing="12">

                                <HorizontalStackLayout Spacing="10">
                                    <buttons:SfButton Command="{Binding Start}" Text="Start session" />
                                    <buttons:SfButton Command="{Binding Stop}" Text="Stop" />
                                </HorizontalStackLayout>

                                <Border Style="{StaticResource Card}">
                                    <VerticalStackLayout Spacing="6">
                                        <Label Style="{StaticResource Caption}" Text="STATUS" />
                                        <Label Style="{StaticResource Value}" Text="{Binding Status}" />
                                        <Label
                                            IsVisible="{Binding HasTag}"
                                            Style="{StaticResource Value}"
                                            Text="{Binding TagId, StringFormat='Tag {0}'}" />
                                    </VerticalStackLayout>
                                </Border>

                                <Label Style="{StaticResource Caption}" Text="NDEF RECORDS" />
                            </VerticalStackLayout>

                            <CollectionView Grid.Row="1" ItemsSource="{Binding Records}">
                                <CollectionView.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <Border Margin="16,0,16,10" Style="{StaticResource Card}">
                                            <Label Style="{StaticResource Value}" Text="{Binding .}" />
                                        </Border>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </Grid>
                    </tabView:SfTabItem.Content>
                </tabView:SfTabItem>

                <!-- Me.Toolkit.Maui.WebHostPatch -->
                <tabView:SfTabItem Header="Web host">
                    <tabView:SfTabItem.Content>
                        <ScrollView BindingContext="{Binding WebHost}">
                            <VerticalStackLayout Padding="16,14" Spacing="12">

                                <Label
                                    Style="{StaticResource Blurb}"
                                    Text="Kestrel, inside this app, from netstandard2.0 packages — the only route that reaches Android and iOS." />

                                <HorizontalStackLayout Spacing="10">
                                    <buttons:SfButton Command="{Binding Start}" Text="Start server" />
                                    <buttons:SfButton Command="{Binding Stop}" Text="Stop" />
                                </HorizontalStackLayout>

                                <Border Style="{StaticResource Card}">
                                    <VerticalStackLayout Spacing="6">
                                        <Label Style="{StaticResource Caption}" Text="STATUS" />
                                        <Label Style="{StaticResource Value}" Text="{Binding Status}" />
                                    </VerticalStackLayout>
                                </Border>

                                <Border IsVisible="{Binding IsRunning}" Style="{StaticResource Card}">
                                    <VerticalStackLayout Spacing="6">
                                        <Label Style="{StaticResource Caption}" Text="OPEN THIS FROM ANOTHER DEVICE" />
                                        <Label
                                            FontAttributes="Bold"
                                            FontSize="17"
                                            Text="{Binding Address}" />
                                    </VerticalStackLayout>
                                </Border>

                            </VerticalStackLayout>
                        </ScrollView>
                    </tabView:SfTabItem.Content>
                </tabView:SfTabItem>

                <!--
                    Me.Toolkit.Maui.Sizing. Resize the window or rotate the device: nothing on this tab
                    has a fixed size. Each "measured" label reads the element's actual laid-out width
                    back, so what is claimed is also what is shown.
                -->
                <tabView:SfTabItem Header="Sizing">
                    <tabView:SfTabItem.Content>
                        <ScrollView>
                            <VerticalStackLayout Padding="16,14" Spacing="12">

                                <Label
                                    Style="{StaticResource Blurb}"
                                    Text="Resize the window or rotate the device. Every size below is a percentage of something, recomputed as it changes." />

                                <Border Style="{StaticResource Card}">
                                    <VerticalStackLayout Spacing="6">
                                        <Label Style="{StaticResource Caption}" Text="30% OF THE PARENT" />
                                        <BoxView
                                            x:Name="ParentBox"
                                            HeightRequest="20"
                                            HorizontalOptions="Start"
                                            Color="#512BD4"
                                            WidthRequest="{me:Relative 30}" />
                                        <Label
                                            x:DataType="BoxView"
                                            BindingContext="{x:Reference ParentBox}"
                                            Style="{StaticResource Value}"
                                            Text="{Binding Width, StringFormat='measured {0:F0}'}" />
                                    </VerticalStackLayout>
                                </Border>

                                <Border Style="{StaticResource Card}">
                                    <VerticalStackLayout Spacing="6">
                                        <Label Style="{StaticResource Caption}" Text="3% OF THE WINDOW WIDTH, CLAMPED 12 TO 40" />
                                        <Label
                                            x:Name="WindowText"
                                            FontSize="{me:Relative 3, To=Window, Min=12, Max=40}"
                                            Text="Scales with the window" />
                                        <Label
                                            x:DataType="Label"
                                            BindingContext="{x:Reference WindowText}"
                                            Style="{StaticResource Value}"
                                            Text="{Binding FontSize, StringFormat='font size {0:F1}'}" />
                                    </VerticalStackLayout>
                                </Border>

                                <Border Style="{StaticResource Card}">
                                    <VerticalStackLayout Spacing="6">
                                        <Label Style="{StaticResource Caption}" Text="15% OF THE DISPLAY'S SHORTER SIDE, SQUARE" />
                                        <Image
                                            x:Name="DisplayImage"
                                            Aspect="AspectFill"
                                            HeightRequest="{me:Relative 15, To=Display, Axis=Shorter}"
                                            HorizontalOptions="Start"
                                            Source="me.png"
                                            WidthRequest="{me:Relative 15, To=Display, Axis=Shorter}" />
                                        <Label
                                            x:DataType="Image"
                                            BindingContext="{x:Reference DisplayImage}"
                                            Style="{StaticResource Value}"
                                            Text="{Binding Width, StringFormat='measured {0:F0}'}" />
                                    </VerticalStackLayout>
                                </Border>

                                <Border Style="{StaticResource Card}">
                                    <VerticalStackLayout Spacing="6">
                                        <Label Style="{StaticResource Caption}" Text="ONIDIOM INSIDE: 80% PHONE, 50% TABLET, 40% DESKTOP" />
                                        <BoxView
                                            x:Name="IdiomInside"
                                            HeightRequest="20"
                                            HorizontalOptions="Start"
                                            Color="#2B9E6B"
                                            WidthRequest="{me:Relative Percent={OnIdiom Phone=80, Tablet=50, Desktop=40, Default=40}}" />
                                        <Label
                                            x:DataType="BoxView"
                                            BindingContext="{x:Reference IdiomInside}"
                                            Style="{StaticResource Value}"
                                            Text="{Binding Width, StringFormat='measured {0:F0}'}" />
                                    </VerticalStackLayout>
                                </Border>

                                <!-- Orientation is the window's shape, not the parent's: this card
                                     is wider than it is tall in a portrait window too. -->
                                <Border Style="{StaticResource Card}">
                                    <VerticalStackLayout Spacing="6">
                                        <Label Style="{StaticResource Caption}" Text="90% IN A PORTRAIT WINDOW, 45% IN A LANDSCAPE ONE" />
                                        <BoxView
                                            x:Name="Oriented"
                                            HeightRequest="20"
                                            HorizontalOptions="Start"
                                            Color="#D4722B"
                                            WidthRequest="{me:Relative Portrait=90, Landscape=45}" />
                                        <Label
                                            x:DataType="BoxView"
                                            BindingContext="{x:Reference Oriented}"
                                            Style="{StaticResource Value}"
                                            Text="{Binding Width, StringFormat='measured {0:F0}'}" />
                                    </VerticalStackLayout>
                                </Border>

                                <Border Style="{StaticResource Card}">
                                    <VerticalStackLayout Spacing="6">
                                        <Label Style="{StaticResource Caption}" Text="16:9 OF ITS OWN WIDTH (TO=SELF)" />
                                        <BoxView
                                            x:Name="Video"
                                            Color="#512BD4"
                                            HeightRequest="{me:Relative 56.25, To=Self}"
                                            WidthRequest="{me:Relative 50}"
                                            HorizontalOptions="Start" />
                                        <HorizontalStackLayout x:DataType="BoxView" BindingContext="{x:Reference Video}" Spacing="4">
                                            <Label Style="{StaticResource Value}" Text="{Binding Width, StringFormat='measured {0:F0}'}" />
                                            <Label Style="{StaticResource Value}" Text="{Binding Height, StringFormat='x {0:F0}'}" />
                                        </HorizontalStackLayout>
                                    </VerticalStackLayout>
                                </Border>

                                <Border Style="{StaticResource Card}">
                                    <VerticalStackLayout Spacing="6">
                                        <Label Style="{StaticResource Caption}" Text="TWO HALVES LESS A GAP: 50%, OFFSET=-4, SPACING 8" />
                                        <HorizontalStackLayout Spacing="8">
                                            <BoxView x:Name="LeftHalf" HeightRequest="20" Color="#2B9E6B" WidthRequest="{me:Relative 50, Offset=-4, AncestorType={x:Type VerticalStackLayout}}" />
                                            <BoxView HeightRequest="20" Color="#2B9E6B" WidthRequest="{me:Relative 50, Offset=-4, AncestorType={x:Type VerticalStackLayout}}" />
                                        </HorizontalStackLayout>
                                        <Label
                                            x:DataType="BoxView"
                                            BindingContext="{x:Reference LeftHalf}"
                                            Style="{StaticResource Value}"
                                            Text="{Binding Width, StringFormat='each measured {0:F0}'}" />
                                    </VerticalStackLayout>
                                </Border>

                                <!-- A Style carrying a relative size: the Setter is shared, each label
                                     gets its own binding. {me:Relative} cannot go in a Setter. -->
                                <Border Style="{StaticResource Card}">
                                    <VerticalStackLayout Spacing="6">
                                        <Label Style="{StaticResource Caption}" Text="FROM A STYLE: 4% OF THE WINDOW, 14 TO 48" />
                                        <Label x:Name="Styled" Style="{StaticResource RelativeHeadline}" Text="Styled headline" />
                                        <Label
                                            x:DataType="Label"
                                            BindingContext="{x:Reference Styled}"
                                            Style="{StaticResource Value}"
                                            Text="{Binding FontSize, StringFormat='font size {0:F1}'}" />
                                    </VerticalStackLayout>
                                </Border>

                            </VerticalStackLayout>
                        </ScrollView>
                    </tabView:SfTabItem.Content>
                </tabView:SfTabItem>

            </tabView:SfTabView.Items>
        </tabView:SfTabView>
    </Grid>

</ContentPage>
